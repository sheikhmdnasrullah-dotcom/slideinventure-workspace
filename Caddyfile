# Caddyfile for the workstation.
#
# - All HTTPS is handled by Caddy (auto-TLS via the email below).
# - The Next.js app listens on :3000.
#
# Place at /etc/caddy/Caddyfile and run: caddy reload --config /etc/caddy/Caddyfile

{
	email admin@yourdomain.com
}

yourdomain.com {
	reverse_proxy localhost:3000
}
