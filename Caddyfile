# Caddyfile for the SlideIn production VPS.
#
# - www/app: the workspace-app dashboard (Next.js on :3001)
# - track: GoPhish landing + click-tracking server (:8080), the public
#   URL baked into campaigns via GOPHISH_CAMPAIGN_URL
# - GoPhish admin (:8333) is intentionally NOT exposed; use ssh -L.
#
# Place at /etc/caddy/Caddyfile and run: caddy reload --config /etc/caddy/Caddyfile

{
	email hello@nasrullahtanim.me
}

# NOTE: www stays on Vercel (marketing site) — never point it here.
slideinventure.com {
	reverse_proxy localhost:3001
}

app.slideinventure.com {
	reverse_proxy localhost:3001
}

track.slideinventure.com {
	reverse_proxy localhost:8080
}

# GoPhish campaign console (admin UI + API). GoPhish serves plain HTTP
# on loopback (use_tls=false); Caddy terminates public TLS. CSRF origins
# must include this host (admin_server.trusted_origins); first login uses
# the journal temp password, then forces a change.
console.slideinventure.com {
	reverse_proxy localhost:8333
}

# Warmbly self-hosted platform (loopback services in /opt/warmbly).
warmbly.slideinventure.com {
	reverse_proxy localhost:5173
}

warmbly-api.slideinventure.com {
	handle /socket/* {
		reverse_proxy localhost:4000
	}
	handle {
		reverse_proxy localhost:8180
	}
}

warmbly-track.slideinventure.com {
	reverse_proxy localhost:3200
}
