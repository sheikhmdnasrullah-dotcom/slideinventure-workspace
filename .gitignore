# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!env.example

# appwrite / supabase config with real secrets — never commit
appwrite.config.json

# prospect leads, evaluation data, and logs — private
Efa.csv
efa-results.json
efa-run.log
.data/

# vscode mcp auth tokens — never commit
.vscode/mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# playwright output
/test-results
/playwright-report
.aider*

# project workspace files (user content; may be sensitive — never commit)
# Overridable at runtime via PROJECT_WORKSPACE_DIR.
/data
